+    public void End()
+    {
+        lock (gate)
+        {
+            if (ticketOwner != this || ticketDepth <= 0) return;
+            ticketDepth--;
+            if (ticketDepth != 0) return;
+            ticketOwner = null;
+            if (mutations > 0) mutations--;
+            Monitor.PulseAll(gate);
+        }
+    }
