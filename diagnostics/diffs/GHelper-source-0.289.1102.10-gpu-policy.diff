+    public XgDockSnapshot Peek()
+    {
+        if (!Enabled) return XgDockSnapshot.Unsampled();
+        lock (gate)
+        {
+            if (transition > 0) return TransitionSnapshot();
+        }
+        var fresh = ReadFresh();
+        lock (gate)
+        {
