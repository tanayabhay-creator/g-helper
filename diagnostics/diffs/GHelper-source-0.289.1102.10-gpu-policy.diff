+    public void EnterTransition(string caller)
+    {
+        lock (gate)
+        {
+            transitionPending++;
+            try
+            {
+                while (mutations > 0)
+                {
+                    transitionWaits++;
+                    TransitionWaiting?.Set();
+                    Monitor.Wait(gate);
+                }
+                transition++;
+                epoch++;
+                last = TransitionSnapshot();
+            }
+            finally
+            {
+                transitionPending--;
+            }
+        }
+        if (Enabled)
+            Emit("transition", caller, "transition", AsusACPI.GPUXG, "begin", "flag_set", TransitionSnapshot(), false);
+    }
